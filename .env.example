# ==============================================================================
# ConecteMapas - Variáveis de Ambiente (Modelo)
# Copie este arquivo para .env caso deseje configurar via variáveis de ambiente.
# ==============================================================================

# Driver e Host do Banco MySQL
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306

# Nome do Banco, Usuário e Senha
DB_NAME=u941736878_conectemapas
DB_USER=u941736878_conectemapas
DB_PASS=sua_senha_aqui

# CORS: em produção, restrinja as origens que podem chamar a API (separadas por vírgula).
# Se vazio, a API responde Access-Control-Allow-Origin: * (aceitável só porque a autenticação é por token em header).
CM_ALLOWED_ORIGINS=https://seu-dominio.com.br

# Diagnóstico: 1 devolve mensagens de erro reais na resposta. Deixe vazio em produção.
CM_DEBUG=
